{
  "name": "@swarmie/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "cf-typegen": "mkdir -p .wrangler && wrangler types .wrangler/worker-configuration.d.ts",
    "generate:routes": "bun -e 'import { Generator, getConfig } from \"@tanstack/router-generator\"; await new Generator({ config: getConfig({ generatedRouteTree: \".tanstack/routeTree.gen.ts\" }), root: process.cwd() }).run()'",
    "typecheck": "bun run generate:routes && bun run cf-typegen && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "format": "bun run --cwd ../.. format",
    "format:check": "bun run --cwd ../.. format:check",
    "lint": "bun run --cwd ../.. lint"
  },
  "dependencies": {
    "@swarmie/ui-web": "workspace:*",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.56",
    "effect": "3.22.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@swarmie/config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.38",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  }
}
