{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swarmie-web-dev",
  "routes": [{ "pattern": "www-dev.swarmie.ai", "custom_domain": true }],
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "RESEND_NEWSLETTER_SEGMENT_ID": "" },
  "secrets": { "required": ["RESEND_NEWSLETTER_API_KEY"] },
  "env": {
    "dev": {
      "name": "swarmie-web-dev",
      "routes": [{ "pattern": "www-dev.swarmie.ai", "custom_domain": true }],
      "vars": { "RESEND_NEWSLETTER_SEGMENT_ID": "" },
      "secrets": { "required": ["RESEND_NEWSLETTER_API_KEY"] },
    },
    "prod": {
      "name": "swarmie-web-prod",
      "routes": [{ "pattern": "swarmie.ai", "custom_domain": true }],
      "vars": { "RESEND_NEWSLETTER_SEGMENT_ID": "" },
      "secrets": { "required": ["RESEND_NEWSLETTER_API_KEY"] },
    },
  },
}
