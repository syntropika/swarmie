{
  "extends": "@swarmie/config/ts/native.json",
  "compilerOptions": {
    "types": ["react", "react-native", "bun"],
    "paths": {
      "~/*": ["./*"]
    }
  },
  "include": [
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "*.ts",
    ".expo/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules", "android", "ios"]
}
