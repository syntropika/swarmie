{
  "name": "swarmie-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && native dev",
    "dev:web": "vite --config vite.config.ts",
    "dev:demo": "vite --config vite.demo.config.ts",
    "build:web": "tsc --noEmit && vite build --config vite.config.ts",
    "build:demo": "tsc --noEmit -p tsconfig.demo.json && vite build --config vite.demo.config.ts",
    "build": "npm run build:web && native build",
    "check": "tsc --noEmit && native check --strict",
    "test": "vitest run && native test",
    "typecheck": "tsc --noEmit",
    "lint": "bun run --cwd ../.. lint",
    "format": "bun run --cwd ../.. format",
    "test:web": "vitest run"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.23",
    "@assistant-ui/react-markdown": "0.14.18",
    "@swarmie/contracts": "workspace:*",
    "@swarmie/ui-web": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.20.0",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lucide-react": "0.468.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@native-sdk/cli": "0.10.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
