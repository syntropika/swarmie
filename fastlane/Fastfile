require_relative "apple_signing"
require_relative "mobile_ios"

skip_docs
default_platform(:ios)

platform :ios do
  desc "Archive the selected mobile variant, optionally signing with readonly Match"
  lane :build do |options|
    begin
      settings = MobileIOS.settings(ENV, signing: options.fetch(:signing))
      AppleSigning.validate_storage!(ENV) if settings.fetch(:signed)
    rescue KeyError
      UI.user_error!("Build requires a signing:unsigned or signing:signed parameter")
    rescue ArgumentError => error
      UI.user_error!(error.message)
    end

    parameters = MobileIOS.build_options(settings)
    if settings.fetch(:signed)
      setup_ci(force: true, timeout: 7200)
      match(app_identifier: [settings.fetch(:identifier)], type: "appstore", readonly: true)
      mapping = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
      profile = mapping&.fetch(settings.fetch(:identifier), nil)
      UI.user_error!("Readonly Match did not return a profile for the selected identifier") unless profile
      update_code_signing_settings(
        path: settings.fetch(:project),
        targets: [settings.fetch(:scheme)],
        build_configurations: ["Release"],
        use_automatic_signing: false,
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        bundle_identifier: settings.fetch(:identifier),
        code_sign_identity: "Apple Distribution",
        profile_name: profile,
      )
      parameters.merge!(
        export_method: "app-store",
        export_options: {
          signingStyle: "manual",
          teamID: ENV.fetch("APPLE_TEAM_ID"),
          provisioningProfiles: { settings.fetch(:identifier) => profile },
        },
      )
    end
    build_app(**parameters)
  end

  desc "Upload an existing signed archive to TestFlight without distributing to testers"
  lane :upload do
    begin
      settings = MobileIOS.settings(ENV, signing: "signed")
      ipa = File.join(settings.fetch(:output), "swarmie.ipa")
      raise ArgumentError, "Build a signed IPA before uploading to TestFlight" unless File.file?(ipa) && File.size?(ipa)

      api_options = AppleSigning.api_options(ENV)
    rescue ArgumentError => error
      UI.user_error!(error.message)
    end
    api_key = app_store_connect_api_key(**api_options)
    upload_to_testflight(
      api_key: api_key,
      app_identifier: settings.fetch(:identifier),
      ipa: ipa,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end

  desc "Inspect or synchronize Apple signing for one app variant"
  lane :signing do |options|
    begin
      selection = AppleSigning.selection(
        operation: options.fetch(:operation),
        variant: options.fetch(:variant),
        profile: options.fetch(:profile),
      )
      UI.message("Signing request: #{selection.fetch(:operation)} / #{options.fetch(:variant)} / #{selection.fetch(:profile)}")
      AppleSigning.validate_storage!(ENV)
      api_options = AppleSigning.api_options(ENV)
      verified_files = AppleSigning.verify_storage!(ENV)
    rescue KeyError
      UI.user_error!("Signing requires operation:, variant: and profile: parameters; use just mobile-signing.")
    rescue ArgumentError => error
      UI.user_error!(error.message)
    end

    if verified_files.zero?
      UI.important("Match storage is uninitialized: no signing material exists, so MATCH_PASSWORD is not verified.")
    else
      UI.success("Match branch and password verified by decrypting #{verified_files} signing files in a temporary clone.")
    end

    api_key = app_store_connect_api_key(**api_options)
    target = selection.fetch(:target)
    existing = AppleSigning.bundle_id(Spaceship::ConnectAPI::BundleId, target, create: false)
    UI.message("Bundle ID #{target.fetch(:identifier)}: #{existing ? 'registered' : 'not registered'}")

    if selection.fetch(:operation) == "inspect"
      # A provisioning API request validates that this is a usable team API key.
      certificates = Spaceship::ConnectAPI::Certificate.all
      UI.success("Apple provisioning API access verified (#{certificates.length} certificates visible)")
      UI.message("Inspection did not register identifiers, create profiles or change signing storage.")
    else
      if selection.fetch(:profile) != "appstore"
        devices = Spaceship::ConnectAPI::Device.all(filter: { platform: "IOS", status: "ENABLED" })
        UI.user_error!("Register an iOS test device before creating development or ad hoc profiles") if devices.empty?
      end

      setup_ci(force: true, timeout: 3600)
      identifier = existing || AppleSigning.bundle_id(Spaceship::ConnectAPI::BundleId, target, create: true)
      AppleSigning.sync_capabilities!(identifier)
      Match::Storage::GitStorage.prepend(AppleSigning::ConventionalCommits)
      parameters = {
        api_key: api_key,
        app_identifier: [target.fetch(:identifier)],
        type: selection.fetch(:profile),
        generate_apple_certs: true,
        skip_docs: true,
      }
      match(**parameters, readonly: false, force: true)
      # A fresh readonly clone verifies that the encrypted output can be fetched
      # again; certificates left only in a temporary checkout are insufficient.
      match(**parameters, readonly: true)
    end
  end
end
