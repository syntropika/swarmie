#!/bin/sh
# Isolated GUI fixture: use the installed CLI with a bounded prompt and tool catalog.
set -eu
: "${SWARMIE_CLAUDE_REAL_EXECUTABLE:=${SWARMIE_CLAUDE_EXECUTABLE:-}}"
: "${SWARMIE_CLAUDE_REAL_EXECUTABLE:?Set SWARMIE_CLAUDE_REAL_EXECUTABLE to the real Claude Code executable}"
exec "$SWARMIE_CLAUDE_REAL_EXECUTABLE" --bare \
  --system-prompt "Follow the user's instructions. Use the available tools when requested. Never invent file contents or claim a tool ran without using it." \
  --tools "${SWARMIE_CLAUDE_TOOLS:-Read,Edit,Write,Bash}" "$@"
