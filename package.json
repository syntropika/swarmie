{
  "name": "swarmie",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "packages/*",
    "sdk/typescript"
  ],
  "type": "module",
  "scripts": {
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "build:desktop": "bun run --cwd apps/desktop build",
    "storybook": "bun run --filter @swarmie/ui storybook",
    "build:storybook": "bun run --filter @swarmie/ui build-storybook",
    "typecheck": "bun run --filter swarmie-desktop typecheck && bun run --filter @swarmie/client typecheck && bun run --filter @swarmie/ui typecheck",
    "lint": "bun run lint:code",
    "lint:code": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:design": "oxlint --deny-warnings apps/desktop/web/src packages/ui/src",
    "lint:fix": "oxlint --fix --deny-warnings",
    "lint:doctor": "ultracite doctor",
    "format": "node node_modules/oxfmt/bin/oxfmt .",
    "format:check": "node node_modules/oxfmt/bin/oxfmt --check .",
    "test": "bun run test:contracts && bun run test:ui && bun run --cwd apps/desktop test:web && bun run --cwd sdk/typescript test",
    "check": "bun run format:check && bun run typecheck && bun run lint:code && bun run test",
    "lint:shared": "oxlint --deny-warnings --report-unused-disable-directives oxlint.config.ts oxfmt.config.ts packages/config packages/ui",
    "format:shared:check": "node node_modules/oxfmt/bin/oxfmt --check oxlint.config.ts oxfmt.config.ts package.json tsconfig.json packages/config packages/ui",
    "check:ui": "bun run format:shared:check && bun run --filter @swarmie/ui typecheck && bun run lint:shared",
    "test:ui": "bun test packages/ui",
    "test:contracts": "tsc --noEmit -p packages/contracts/tsconfig.json && bun test packages/contracts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@shadcn/lint": "0.2.0",
    "@swarmie/config": "workspace:*",
    "@types/bun": "1.3.10",
    "@types/node": "24.13.6",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.12.0"
  },
  "overrides": {
    "@types/node": "24.13.6"
  },
  "packageManager": "bun@1.3.10"
}
