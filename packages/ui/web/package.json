{
  "name": "@swarmie/ui-web",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./elements": "./src/elements/index.ts",
    "./elements/conversation": "./src/elements/conversation.tsx",
    "./theme": "./src/theme-preference.ts",
    "./code": "./src/code/index.tsx"
  },
  "scripts": {
    "storybook": "bun run --cwd ../../.. ui:elements:prepare && storybook dev --port 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "bun run --cwd ../../.. ui:elements:prepare && storybook build --disable-telemetry",
    "typecheck": "bun run --cwd ../../.. ui:elements:prepare && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@assistant-ui/generative-ui": "0.0.7",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@react-aria/utils": "3.34.1",
    "@swarmie/config": "workspace:*",
    "@tanstack/react-virtual": "3.14.13",
    "beautiful-mermaid": "1.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "heat-graph": "0.0.26",
    "leaflet": "1.9.4",
    "lucide-react": "1.61.0",
    "react-aria": "3.53.1",
    "react-markdown": "10.1.0",
    "react-shiki": "0.11.2",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@gravity-ui/icons": "2.23.0",
    "@iconify/react": "6.0.2",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.21",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
