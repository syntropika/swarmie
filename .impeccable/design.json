      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border:0;border-radius:8px;font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;font-weight:500;line-height:1.5;white-space:nowrap;outline:none;transition:color 150ms,background-color 150ms;background:var(--color-control-secondary,#303030);color:var(--color-foreground,#e3e3e3);}.ds-secondary:hover{background:var(--color-control-hover,#3a3a3a);}.ds-secondary:focus-visible{box-shadow:0 0 0 2px var(--color-background,#181818),0 0 0 4px var(--color-focus,#aaa8ef);}.ds-secondary:disabled{opacity:0.4;pointer-events:none;}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none;}}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Shared ghost button with Tailwind-owned dimensions, type, and states.",
      "html": "<button class=\"ds-ghost\">This computer</button>",
      "css": ".ds-ghost{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border:0;border-radius:8px;font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;font-weight:500;line-height:1.5;white-space:nowrap;outline:none;transition:color 150ms,background-color 150ms;background:transparent;color:var(--color-foreground,#e3e3e3);}.ds-ghost:hover{background:var(--color-control-hover,#3a3a3a);}.ds-ghost:focus-visible{box-shadow:0 0 0 2px var(--color-background,#181818),0 0 0 4px var(--color-focus,#aaa8ef);}.ds-ghost:disabled{opacity:0.4;pointer-events:none;}.ds-ghost:active{background:var(--color-control-hover,#3a3a3a);}@media(prefers-reduced-motion:reduce){.ds-ghost{transition:none;}}"
    },
    {
      "name": "Shared Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Shared field styling with a named DOM input.",
      "html": "<input class=\"ds-input\" aria-label=\"Folder path\" placeholder=\"Absolute directory path\" />",
      "css": ".ds-input{height:36px;width:100%;padding:0 12px;border:1px solid var(--color-border,#383838);border-radius:8px;background:var(--color-control-secondary,#303030);color:var(--color-foreground,#e3e3e3);font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;line-height:1.5;outline:none;}.ds-input::placeholder{color:var(--color-muted,#aaa);}.ds-input:focus-visible{box-shadow:0 0 0 2px var(--color-focus,#aaa8ef);}.ds-input:disabled{opacity:0.4;cursor:not-allowed;}"
    },
    {
      "name": "Chat Navigation",
      "kind": "nav",
      "refersTo": "chat-row",
      "description": "Chat selection and hover/focus actions are sibling shared buttons; pinned rows retain Unpin at rest.",
      "html": "<nav aria-label=\"Chats\"><div class=\"ds-chat-group\"><button class=\"ds-row\">Untitled chat</button><div class=\"ds-chat-actions\"><button class=\"ds-chat-icon\" aria-label=\"Pin chat: Untitled chat\" title=\"Pin chat\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 17v5\"></path><path d=\"M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z\"></path></svg></button><button class=\"ds-chat-icon\" aria-label=\"Chat options: Untitled chat\" title=\"Chat options\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"1\"></circle><circle cx=\"19\" cy=\"12\" r=\"1\"></circle><circle cx=\"5\" cy=\"12\" r=\"1\"></circle></svg></button></div></div></nav>",
      "css": ".ds-row{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 64px 0 12px;border:0;border-radius:8px;font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;font-weight:500;line-height:1.5;white-space:nowrap;outline:none;transition:color 150ms,background-color 150ms;width:100%;justify-content:flex-start;background:transparent;color:var(--color-foreground,#e3e3e3);}.ds-chat-group:hover,.ds-chat-group:focus-within{background:var(--color-control-hover,#3a3a3a);}.ds-row:hover,.ds-row:active{background:transparent;}.ds-row:focus-visible{box-shadow:0 0 0 2px var(--color-background,#181818),0 0 0 4px var(--color-focus,#aaa8ef);}@media(prefers-reduced-motion:reduce){.ds-row{transition:none;}} .ds-chat-group{position:relative;border-radius:8px;}.ds-chat-actions{position:absolute;inset:0 4px 0 auto;display:flex;align-items:center;gap:2px;pointer-events:none;opacity:0;}.ds-chat-group:hover .ds-chat-actions,.ds-chat-group:focus-within .ds-chat-actions{pointer-events:auto;opacity:1;}.ds-chat-icon{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;border:0;border-radius:8px;background:transparent;color:var(--color-muted,#aaa);outline:none;transition:background-color 150ms;}.ds-chat-icon:hover,.ds-chat-icon:active{background:var(--color-control-hover,#3a3a3a);}.ds-chat-icon:focus-visible{box-shadow:0 0 0 2px var(--color-background,#181818),0 0 0 4px var(--color-focus,#aaa8ef);}@media(prefers-reduced-motion:reduce){.ds-chat-icon{transition:none;}}"
    },
    {
      "name": "Shared Badge",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Compact neutral badge from the shared primitive classes.",
      "html": "<span class=\"ds-badge\">Installed</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;border-radius:6px;padding:2px 6px;background:var(--color-control-secondary,#303030);color:var(--color-muted,#aaa);font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:11px;font-weight:500;line-height:1.5;}"
    },
    {
      "name": "Permission Content",
      "kind": "card",
      "refersTo": "permission-card",
      "description": "A source-defined permission content surface hosting native actions.",
      "html": "<section class=\"ds-permission\"><strong class=\"ds-permission-title\">Permission required</strong><p class=\"ds-permission-copy\">Review the requested action before continuing.</p></section>",
      "css": ".ds-permission{padding:14px;border:1px solid #54513c;border-radius:10px;background:#24241e;font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:12px;}.ds-permission-title{color:#e8deb2;}.ds-permission-copy{color:#ccc;line-height:1.6;}"
    },
    {
      "name": "Context-Topped Composer",
      "kind": "custom",
      "refersTo": "composer",
      "description": "Specialized draft with an embedded harness-state dot on the cap left, computer on the right, left permissions, and right context/model controls; no bottom caption.",
      "html": "<div class=\"ds-composer-wrap\"><div class=\"ds-context\"><button class=\"ds-composer-button\" aria-label=\"Select installed harness\" title=\"Idle: Ready for your next message\"><span class=\"ds-harness-dot\" aria-hidden=\"true\"></span>Installed harness<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><span class=\"ds-composer-spacer\"></span><button class=\"ds-composer-button\">This computer</button></div><div class=\"ds-composer\"><textarea class=\"ds-draft\" aria-label=\"Message\" placeholder=\"Ask anything\" ></textarea><div class=\"ds-toolbar\"><button class=\"ds-composer-button ds-composer-icon\" aria-label=\"Attach files or images\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"></path></svg></button><button class=\"ds-composer-button\" aria-label=\"Change permissions\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path></svg>Permissions</button><span class=\"ds-composer-spacer\"></span><button class=\"ds-context-wheel\" aria-label=\"Context window: usage unavailable\" title=\"Usage not reported yet. Waiting for harness usage data\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"5.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" opacity=\"0.3\"></circle></svg></button><button class=\"ds-composer-button\" aria-label=\"Select model\">Advertised model</button><button class=\"ds-composer-primary ds-composer-icon\" aria-label=\"Send message\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"m5 12 7-7 7 7M12 19V5\"></path></svg></button></div></div></div>",
      "css": ".ds-composer-wrap{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;}.ds-context{display:flex;align-items:center;justify-content:space-between;gap:4px;min-height:36px;margin:0 12px -1px;padding:0 4px;border-radius:16px 16px 0 0;background:#252525;color:var(--color-foreground,#e3e3e3);font-size:12px;}.ds-composer{background:#303030;border-radius:22px;transition:box-shadow 140ms;}.ds-composer:focus-within{box-shadow:0 0 0 1px #4c4c4c;}.ds-draft{width:100%;min-height:56px;max-height:220px;padding:16px 16px 8px;border:0;border-radius:22px 22px 0 0;background:none;color:#e2e2e2;outline:none;resize:none;font-family:inherit;font-size:14px;line-height:20px;}.ds-draft::placeholder{color:#aaa;}@media(prefers-reduced-motion:reduce){.ds-composer{transition:none;}}.ds-toolbar{display:flex;align-items:center;gap:4px;min-height:40px;padding:0 8px 8px;flex-wrap:wrap;}.ds-composer-spacer{flex:1;min-width:0;}.ds-composer-button{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:28px;padding:0 10px;border:0;border-radius:8px;font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;font-weight:500;line-height:1.5;white-space:nowrap;outline:none;transition:color 150ms,background-color 150ms;background:transparent;color:var(--color-foreground,#e3e3e3);}.ds-composer-button:hover{background:var(--color-control-hover,#3a3a3a);}.ds-composer-button:focus-visible{box-shadow:0 0 0 2px var(--color-background,#181818),0 0 0 4px var(--color-focus,#aaa8ef);}.ds-composer-button:disabled{opacity:0.4;pointer-events:none;}.ds-composer-button:active{background:var(--color-control-hover,#3a3a3a);}@media(prefers-reduced-motion:reduce){.ds-composer-button{transition:none;}}.ds-composer-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:28px;padding:0 10px;border:0;border-radius:8px;font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;font-weight:500;line-height:1.5;white-space:nowrap;outline:none;transition:color 150ms,background-color 150ms;background:var(--color-control-primary,#e3e3e3);color:var(--color-control-primary-foreground,#181818);}.ds-composer-primary:hover{background:#fff;}.ds-composer-primary:focus-visible{box-shadow:0 0 0 2px var(--color-background,#181818),0 0 0 4px var(--color-focus,#aaa8ef);}.ds-composer-primary:disabled{opacity:0.4;pointer-events:none;}@media(prefers-reduced-motion:reduce){.ds-composer-primary{transition:none;}}.ds-composer-button.ds-composer-icon,.ds-composer-primary.ds-composer-icon{width:28px;padding:0;}.ds-composer-button,.ds-composer-primary{border-radius:9999px;}.ds-context > .ds-composer-button:hover,.ds-context > .ds-composer-button:active{background:#4a4a4a;} .ds-harness-dot{width:8px;height:8px;flex-shrink:0;border-radius:50%;background:var(--color-harness-idle,#89d6a3);}.ds-context-wheel{display:flex;align-items:center;justify-content:center;width:28px;height:28px;flex-shrink:0;border:0;border-radius:9999px;padding:0;background:transparent;color:var(--color-muted,#aaa);outline:none;}.ds-context-wheel:hover{background:var(--color-control-hover,#3a3a3a);}.ds-context-wheel:focus-visible{box-shadow:0 0 0 2px var(--color-focus,#aaa8ef);}"
    },
    {
      "name": "Floating Panel Frame",
      "kind": "custom",
      "refersTo": "floating-frame",
      "description": "Shared Radix floating frame with Tailwind-owned material and corner support.",
      "html": "<section class=\"ds-frame\" aria-label=\"Select model\"><div class=\"ds-frame-content\">Select model</div></section>",
      "css": ".ds-frame{background:var(--floating-surface,#212121);color:var(--color-foreground,#e3e3e3);border-radius:var(--floating-radius,12px);box-shadow:var(--floating-shadow,0 10px 15px -3px #0003, 0 4px 6px -4px #0003, 0 0 0 1px #ffffff1a, inset 0 0 0 1px #ffffff0a);font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;line-height:1.5;}.ds-frame-content{padding:16px;}@supports(corner-shape:superellipse(1.5)){.ds-frame{border-radius:15px;corner-shape:superellipse(1.5);}}"
    },
    {
      "name": "Reasoning Effort",
      "kind": "custom",
      "refersTo": "effort-track",
      "description": "Radix Slider geometry; advertised effort commits on release, independently of the native Fast mode toggle.",
      "html": "<div class=\"ds-effort\" aria-label=\"Reasoning effort\"><span class=\"ds-effort-label\">Advertised effort</span><div class=\"ds-track\"><span class=\"ds-fill\"></span><span class=\"ds-thumb\" aria-hidden=\"true\"></span></div></div>",
      "css": ".ds-effort{display:grid;gap:12px;font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;color:var(--color-foreground,#e3e3e3);}.ds-effort-label{color:var(--color-focus,#aaa8ef);}.ds-track{position:relative;height:24px;border-radius:9999px;background:var(--color-control-hover,#3a3a3a);}.ds-fill{position:absolute;inset:0 50% 0 0;border-radius:9999px;background:var(--color-accent,#6966ce);}.ds-thumb{position:absolute;left:calc(50% - 14px);top:-2px;width:28px;height:28px;border-radius:50%;background:#fff;box-shadow:0 1px 2px #0001;}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Local Workbench",
    "overview": "The Quiet Local Workbench gives developers a calm place to run coding-agent conversations against local folders and projects. The approved Codex reference supplies the dark shell, activity rail, resizable sidebar, centered reading column, and rounded composer with a darker computer and harness cap. MPAI uses its own terminal mark and exposes its actual workspace capabilities.\n\nGeneral controls use shared primitives in components/ui. Radix provides popover, Select, menu, dialog, Checkbox, Switch, Collapsible, tooltip, RadioGroup, and Slider behavior; cmdk provides free-text ComboBox keyboard behavior. Tailwind classes style the new primitives using the static theme in styles.css. Existing application layout and conversation-content CSS remains in place. Assistant-ui retains specialized conversation, Markdown, composer, and streaming behavior. Its vendored MIT-licensed Elements supply the command palette and response-copy actions, with capability-dependent host callbacks. Settings replaces the sidebar and conversation with section navigation and a centered content column; project entry opens a centered dialog and project management/review open secondary panels.",
    "keyCharacteristics": [
      "Neutral workspace layers with pale primary actions and a violet effort accent.",
      "Platform system typography and outlined Lucide action icons.",
      "A centered reading column and context-topped bottom composer.",
      "Shared Radix and Tailwind controls inside independently scrolling workspace regions.",
      "Shared focus states and restrained motion with reduced-motion support."
    ],
    "rules": [],
    "dos": [
      "Do preserve the approved dark shell, activity rail, centered conversation, and context-topped composer.",
      "Do use the shared Radix/Tailwind primitives and their static theme tokens for new controls.",
      "Do use application CSS for composition, content surfaces, width constraints, and scrolling.",
      "Do retain assistant-ui for specialized conversation, Markdown, composer, and streaming behavior.",
      "Do keep project entry centered through Open project in the command palette or Add new project in the Projects heading.",
      "Do let Settings span the sidebar and main area with its implemented sections.",
      "Do use actual harness labels, installed choices, advertised models, and native configuration identifiers.",
      "Do keep controls named, preserve keyboard focus, and honor reduced motion.",
      "Do retain useful empty, loading, unavailable, error, and unsupported states."
    ],
    "donts": [
      "Don't add custom CSS skins for new primitives; express their styles through Tailwind classes and shared tokens.",
      "Don't change the 16px root to alter shared rem dimensions.",
      "Don't add decorative gradients or large dashboard headings to this quiet workspace.",
      "Don't wrap every conversation section in a card.",
      "Don't copy the reference application's proprietary mascot or invent unavailable actions.",
      "Don't present absent harnesses as selectable or discovery as proof of authentication.",
      "Don't hardcode model catalogs or reasoning effort scales.",
      "Don't replace Lucide action icons with text glyphs or another icon library."
    ]
  }
}
